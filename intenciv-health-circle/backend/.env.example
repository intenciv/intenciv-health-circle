# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
FRONTEND_URL=https://your-web-panel.vercel.app
SOCKET_CORS_ORIGIN=https://your-web-panel.vercel.app

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Datagen SMS (https://datagenit.com/api/sms-api.php) ───────────────────────
# Auth key from the Datagen portal's HTTP API section.
DATAGEN_AUTH_KEY=
# 6-character DLT-approved header, e.g. INTCIV — must be attached to Datagen
# as telemarketer on the DLT portal (VILPOWER) under our PE ID.
DATAGEN_SENDER_ID=
DATAGEN_COUNTRY_CODE=91
# DLT principal entity id. Optional if a single PE id is saved in the Datagen
# portal; required if none is saved, or if several are and one must be picked.
DATAGEN_ENTITY_ID=1101585970000092735
# Optional: override the endpoint.
# DATAGEN_API_URL=https://global.datagenit.com/API/sms-api.php

# DLT content template ids. Optional — Datagen best-matches on message text —
# but their docs recommend sending them for reliable template resolution.
# The OTP one defaults to 1107177701079148572 in services/datagen.js.
# DATAGEN_OTP_TEMPLATE_ID=1107177701079148572
# DATAGEN_WELCOME_TEMPLATE_ID=

# Message bodies. These MUST match the DLT-approved template text character for
# character; only the {placeholder} slots (the template's {#var#}) may vary.
# The operator matches on content, so any reword is silently scrubbed.
#
# OTP: defaults in services/datagen.js to DLT template 1107177701079148572
# ("OTP Booking OR Login"), verified to match VILPOWER's approved wording —
# so leave it unset unless that template is ever edited.
# DATAGEN_OTP_TEMPLATE=Dear Customer, your OTP for IntenCiv is {otp}. It is valid for 10 minutes. Do not share it with anyone.
#
# Welcome: NO approved DLT template exists yet. Until one is registered on
# VILPOWER and mirrored into Datagen's DLT Setting > Manage Templates, leave
# this unset — the welcome SMS is then skipped instead of being scrubbed.
# Placeholders available: {tier} {coupons} {expiry}
# DATAGEN_WELCOME_TEMPLATE=

# ── Google Play reviewer bypass (both must be set to activate) ────────────────
# PLAY_REVIEWER_PHONE=+919999999999
# PLAY_REVIEWER_OTP=123456
